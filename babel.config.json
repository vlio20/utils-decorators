{
  "targets": {
    "node": "current"
  },
  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": "commonjs"
      }
    ]
  ],
  "plugins": [
    [
      "@babel/plugin-transform-typescript"
    ],
    [
      "@babel/plugin-proposal-decorators",
      {
        "version": "legacy"
      }
    ],
    [
      "@babel/plugin-transform-class-properties"
    ]
  ]
}
